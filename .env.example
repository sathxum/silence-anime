# ============================================================================
# Anime Stream — Environment variables
# Copy to .env.local for local dev, or set these in the Cloudflare Pages
# dashboard (Settings -> Environment variables) for production.
# ============================================================================

# --- Supabase (from your Supabase project -> Settings -> API) ---------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Admin credentials (NEVER stored in the database) -----------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-strong-password

# --- Session signing secret (any long random string) ------------------------
# Generate one:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# --- Public site URL (used for SEO, sitemap, canonical, OG tags) ------------
NEXT_PUBLIC_SITE_URL=https://your-domain.pages.dev

# --- Browser-exposed Supabase values (optional) -----------------------------
# These default to SUPABASE_URL / SUPABASE_ANON_KEY when omitted. Only the
# anon key is ever exposed to the browser — never the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================================
# Migrations only (running `npm run db:migrate` locally) — NOT needed at
# runtime on Cloudflare. One of the following:
#   1) SUPABASE_DB_URL  — full Postgres connection string from
#      Supabase -> Settings -> Database -> Connection string (URI), OR
#   2) SUPABASE_DB_PASSWORD — your database password (the runner builds the
#      connection string from SUPABASE_URL + this password).
# ============================================================================
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=your-database-password
